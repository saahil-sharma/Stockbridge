# Render provides PORT automatically. Use this value for local development.
PORT=8080

# Required for public deployments that query SEC data. Use an app name and a real contact email.
STOCKBRIDGE_SEC_USER_AGENT="Stockbridge/1.0 your-email@example.com"

# Optional for U.S. SEC filers; recommended for broader fallback fundamentals coverage.
STOCKBRIDGE_FMP_API_KEY=
